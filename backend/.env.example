# Live Open Payments only. The Vercel demo does not use these.
# Leave them unset unless you are running backend/index.js yourself.
# Do not commit real values. Any key that was previously in this repo is burnt.

# Sending wallet address. https:// URL, no trailing slash.
OPEN_PAYMENTS_WALLET_ADDRESS_URL=

# Worker wallet that receives the payout. https:// URL, no trailing slash.
OPEN_PAYMENTS_RECEIVING_WALLET_ADDRESS_URL=

# Key id registered on the sending wallet.
OPEN_PAYMENTS_KEY_ID=

# Path to a PEM private key file, relative to the process working directory.
# Prefer this for local runs. Never commit the file (*.key is gitignored).
OPEN_PAYMENTS_PRIVATE_KEY_PATH=

# Optional inline PEM alternative to OPEN_PAYMENTS_PRIVATE_KEY_PATH.
# Quote the value and keep the line breaks if you set it.
# OPEN_PAYMENTS_PRIVATE_KEY=
